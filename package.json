{
  "name": "pydays",
  "productName": "PyDays",
  "version": "1.0.0",
  "description": "PyDays: learn Python in 30 days, one class a day, with a VS Code-style editor, a real Python terminal and a progress calendar. Follows the 30 Days Of Python curriculum.",
  "main": "main.js",
  "license": "GPL-3.0-only",
  "private": true,
  "author": {
    "name": "PyDays contributors"
  },
  "homepage": "https://github.com/nokkiee/pydays",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.mjs",
    "check-content": "node tools/check-content.mjs",
    "shots": "node scripts/smoke.js --shots",
    "icons": "electron scripts/make-icon.js",
    "install-desktop": "scripts/install-desktop.sh",
    "dist": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable",
    "smoke": "node scripts/smoke.js",
    "pack": "electron-builder --linux dir",
    "social": "electron scripts/make-social-preview.js"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/source-serif-4": "^5.2.5",
    "marked": "^18.3.0",
    "monaco-editor": "^0.58.0"
  },
  "build": {
    "appId": "app.pydays",
    "productName": "PyDays",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "content/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/monaco-editor/{esm,dev,node_modules}/**",
      "!node_modules/monaco-editor/*.{md,txt,ts}",
      "!node_modules/marked/{src,bin,man}/**",
      "!node_modules/**/*.map"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icons",
      "synopsis": "Learn Python in 30 days",
      "maintainer": "nokkiee <202015925+nokkiee@users.noreply.github.com>",
      "executableName": "pydays"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "executableName": "PyDays"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "extraResources": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nokkiee/pydays.git"
  },
  "bugs": {
    "url": "https://github.com/nokkiee/pydays/issues"
  }
}
